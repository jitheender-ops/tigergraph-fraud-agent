# TigerGraph Savanna (savanna.tgcloud.io) or Community Edition
TG_HOST=https://<your-workspace>.i.tgcloud.io
TG_GRAPH=FraudInvestigation
TG_USERNAME=tigergraph
TG_PASSWORD=
# Savanna workspaces usually authenticate with a secret rather than a password:
TG_SECRET=

# LLM used for narrative synthesis only (never for picking actions or routes)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Or any OpenAI-compatible endpoint, e.g. Sarvam:
LLM_PROVIDER=openai          # openai | sarvam
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_BASE_URL=https://api.sarvam.ai/v1

# Tokens that authorise releasing held actions (POST /api/case/{id}/release).
# The tier comes from which token matches; L2 can release L1 work, not the reverse.
APPROVER_TOKEN_L1=
APPROVER_TOKEN_L2=
